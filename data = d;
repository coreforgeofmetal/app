<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Core Forge of Metal</title>
<meta name="description" content="Täglich Metal-News, Neuerscheinungen und Konzerte mit Ticketlinks – Core Forge of Metal.">
<meta name="theme-color" content="#000000">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="32x32" href="icon-32.png">
<link rel="apple-touch-icon" href="icon-180.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Core Forge">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<link rel="stylesheet" href="fonts.css">
<style>
:root{
  --bg:#0A0A0A; --bar:#000000; --line:#1F1F1F;
  --card:#190B0B; --card-line:#4A1515; --tint:#2A0D0D;
  --red:#D10A0A; --red-hi:#FF4538; --red-deep:#8E0B0B;
  --text:#F2F2F2; --muted:#A8A8A8; --soft:#B0B0B0;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:'Barlow',system-ui,-apple-system,'Segoe UI',sans-serif;font-size:16px;line-height:1.4}
a{color:inherit}
button{font-family:inherit}
:focus-visible{outline:2px solid var(--red-hi);outline-offset:2px}

.app{max-width:560px;margin:0 auto;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}

.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:calc(12px + env(safe-area-inset-top)) 20px 12px;background:var(--bar);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px;min-width:0;text-decoration:none}
.brand img{width:44px;height:44px;border-radius:11px;display:block;flex:none;background:#2E0C0C;box-shadow:0 0 0 1px #7A1414}
.wm{display:flex;flex-direction:column;line-height:1}
.wm b{font-family:'Oswald',sans-serif;font-weight:700;font-size:22px;letter-spacing:2px;white-space:nowrap}
.wm span{font-family:'Oswald',sans-serif;font-weight:500;font-size:12px;letter-spacing:5px;color:var(--red-hi);margin-top:3px}
.stand{font-size:12px;color:var(--muted);text-align:right;line-height:1.3}

main{flex:1;padding:18px 20px calc(96px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:14px;min-width:0}

.tabs{position:fixed;left:0;right:0;bottom:0;z-index:6;background:var(--bar);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom)}
.tabs .in{display:flex;max-width:560px;margin:0 auto}
.tabs a{flex:1;min-height:64px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
  color:var(--muted);font-size:11px;font-weight:500;text-decoration:none}
.tabs a[aria-current="page"]{color:var(--red-hi);font-weight:600}
.tabs svg{display:block}

.head{display:flex;flex-direction:column;gap:4px;padding:14px 16px;background:var(--card);border:1px solid var(--card-line);border-radius:14px}
.head h1{margin:0;font-family:'Oswald',sans-serif;font-weight:700;font-size:28px;letter-spacing:2px;line-height:1.1}
.head p{margin:0;font-size:14px;color:var(--muted)}

.quiz{display:flex;flex-direction:column;gap:12px;padding:16px;background:linear-gradient(160deg,#2A0D0D 0%,var(--card) 70%);border:1px solid var(--red-deep);border-radius:14px}
.qk{display:flex;align-items:center;justify-content:space-between;font-family:'Oswald',sans-serif;font-weight:600;font-size:14px;letter-spacing:3px;color:var(--red-hi)}
.qq{margin:0;font-family:'Oswald',sans-serif;font-weight:600;font-size:20px;line-height:1.25}
.opts{display:flex;flex-direction:column;gap:8px}
.opt{display:flex;align-items:center;gap:12px;min-height:50px;padding:8px 14px;text-align:left;border:1px solid var(--card-line);border-radius:12px;background:#120808;color:var(--text);font-size:16px;cursor:pointer;width:100%}
.opt:disabled{cursor:default}
.opt .let{flex:none;width:28px;height:28px;border-radius:50%;background:var(--tint);color:var(--red-hi);font-family:'Oswald',sans-serif;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center}
.opt .ot{flex:1;min-width:0;overflow-wrap:anywhere}
.opt .mark{flex:none;font-weight:700;font-size:18px}
.opt.ok{border-color:#2FBF71;background:#0E2417}
.opt.ok .mark{color:#4BE08E}
.opt.no{border-color:var(--red-hi);background:#2A0D0D}
.opt.no .mark{color:var(--red-hi)}
.res{display:flex;flex-direction:column;gap:4px;padding-top:4px;font-size:14px;line-height:1.4;color:var(--soft)}
.res strong{font-family:'Oswald',sans-serif;font-weight:700;font-size:16px;letter-spacing:1.5px}
.res .good{color:#4BE08E}.res .bad{color:var(--red-hi)}
.sr{position:absolute;left:-9999px}
.quiz.bar{padding:0}
.streak{display:flex;align-items:center;gap:12px;padding:12px 16px;background:linear-gradient(160deg,#2A0D0D 0%,var(--card) 70%);border:1px solid var(--red-deep);border-radius:14px}
.streak .sf{flex:none;font-size:30px;line-height:1}
.streak .sb{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.streak .st{font-family:'Oswald',sans-serif;font-weight:700;font-size:18px;letter-spacing:1px;line-height:1.2}
.streak .ss{font-size:13px;color:var(--soft);line-height:1.35}
.streak.off .sf{filter:grayscale(1);opacity:.55}
.streak .ok{color:#4BE08E}
.qbar{display:flex;align-items:center;gap:12px;width:100%;min-height:52px;padding:8px 16px;border:0;background:transparent;color:var(--text);text-align:left;cursor:pointer;border-radius:14px}
.qbar .qk-t{flex:none;font-family:'Oswald',sans-serif;font-weight:600;font-size:14px;letter-spacing:3px;color:var(--red-hi)}

.reel{display:flex;flex-direction:column;gap:12px;padding:16px;background:linear-gradient(160deg,#2A0D0D 0%,var(--card) 70%);border:1px solid var(--red-deep);border-radius:14px}
.reel .rk{display:flex;align-items:center;justify-content:space-between;font-family:'Oswald',sans-serif;font-weight:600;font-size:14px;letter-spacing:3px;color:var(--red-hi)}
.reel .rk .rd{font-size:12px;letter-spacing:1px;color:var(--soft);font-family:inherit;font-weight:400}
.reel .rt{margin:0;font-family:'Oswald',sans-serif;font-weight:600;font-size:20px;line-height:1.25}
.rframe{position:relative;width:100%;aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;border:1px solid var(--card-line)}
.rframe.play{aspect-ratio:auto;height:min(520px,72vh)}
.rframe img{width:100%;height:100%;object-fit:cover;display:block}
.rframe iframe{width:100%;height:100%;border:0;display:block}
.rplay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;width:100%;border:0;background:rgba(0,0,0,.28);cursor:pointer;color:#fff}
.rplay span{display:flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;background:var(--red-hi,#E10600);box-shadow:0 2px 12px rgba(0,0,0,.5)}
.rmore[hidden]{display:none}
.rmore{display:flex;flex-direction:column;gap:6px;padding-top:2px}
.rmore a{display:flex;gap:10px;align-items:baseline;min-height:44px;padding:8px 0;color:var(--text);text-decoration:none;border-top:1px solid var(--card-line);font-size:15px}
.rmore a small{flex:none;color:var(--soft);font-size:12px}
.qbar .qb-s{flex:1;min-width:0;font-size:13px;color:var(--soft)}
.qbar svg{flex:none;color:var(--muted)}
.search{display:flex;align-items:center;gap:10px;height:48px;padding:0 14px;border:1px solid var(--card-line);border-radius:14px;background:var(--card)}
.search:focus-within{border-color:var(--red-hi)}
.search input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-family:inherit;font-size:16px}
.search input::placeholder{color:var(--muted)}
.search svg{flex:none}

.chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin:0 -20px;padding:2px 20px}
.chips::-webkit-scrollbar{display:none}
.chip{height:40px;padding:0 16px;flex:none;white-space:nowrap;border:1px solid var(--card-line);border-radius:20px;background:var(--card);color:var(--text);font-size:14px;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--red);border-color:var(--red);color:#fff;font-weight:600}

.gh{margin:6px 0 -4px;font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;letter-spacing:1.5px;text-transform:uppercase}
.list{display:flex;flex-direction:column;gap:12px}

.card{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--card-line);border-radius:14px}
.row{display:flex;gap:14px;padding:14px;min-width:0}
.avatar{width:52px;height:52px;flex:none;border-radius:10px;background:var(--tint);display:flex;align-items:center;justify-content:center;
  font-family:'Oswald',sans-serif;font-weight:700;font-size:22px;color:var(--red-hi)}
.body{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1}
.band{font-size:12px;font-weight:600;letter-spacing:2px;color:var(--red-hi);text-transform:uppercase;overflow-wrap:anywhere}
.hl{font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;line-height:1.2;overflow-wrap:anywhere}
.q{font-size:14px;line-height:1.35;color:var(--soft)}
.foot{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;padding:2px 6px 2px 14px;border-top:1px solid var(--card-line)}
.pills{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:6px 0}
.pill{height:24px;padding:0 10px;border-radius:12px;background:#262626;color:var(--soft);font-size:11px;font-weight:600;letter-spacing:1px;display:inline-flex;align-items:center;text-transform:uppercase}
.pill.hot{background:var(--red-deep);color:#fff}
.acts{display:flex;gap:0}
.lnk{min-height:44px;padding:0 10px;display:inline-flex;align-items:center;color:var(--red-hi);font-weight:600;font-size:14px;text-decoration:none}

.date{width:58px;height:64px;flex:none;border-radius:10px;background:var(--red-deep);display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.05;color:#fff}
.date small{font-size:11px;font-weight:600;letter-spacing:1px}
.date b{font-family:'Oswald',sans-serif;font-weight:700;font-size:26px}
.when{align-items:center}
.sub{font-size:13px;color:var(--soft);overflow-wrap:anywhere}
.where{font-size:13px;font-weight:600;color:var(--red-hi)}
.ticket{display:flex;flex-direction:column;align-items:center;gap:4px;flex:none;max-width:120px}
.btn{min-height:44px;padding:0 14px;border-radius:10px;background:var(--red);color:#fff;font-weight:600;font-size:14px;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
.ticket small{font-size:11px;color:var(--muted);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.empty{padding:28px 16px;text-align:center;color:var(--muted);border:1px dashed var(--card-line);border-radius:14px;display:flex;flex-direction:column;align-items:center;gap:12px}
.empty strong{color:var(--text);font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;letter-spacing:1px}
.more,.again{min-height:48px;padding:0 20px;border:1px solid var(--card-line);border-radius:14px;background:var(--card);color:var(--text);font-weight:600;font-size:15px;cursor:pointer}
.again{background:var(--red);border-color:var(--red);color:#fff}
.note{font-size:12px;color:var(--muted);text-align:center;padding:8px 0 0}

/* Start-Animation: Die Schmiede wird angeheizt */
#splash{position:fixed;inset:0;z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;
  background:radial-gradient(ellipse at 50% 62%,#3A0D0A 0%,#140505 45%,#000 80%);opacity:1;transition:opacity .5s ease}
#splash.out{opacity:0;pointer-events:none}
#splash .logo{position:relative;width:132px;height:132px;border-radius:30px;display:block;background:#2E0C0C;
  box-shadow:0 0 0 1px #7A1414,0 0 40px 6px rgba(209,10,10,.55)}
#splash .name{font-family:'Oswald',sans-serif;font-weight:700;font-size:26px;letter-spacing:4px;text-align:center;line-height:1.05}
#splash .name span{display:block;font-weight:500;font-size:13px;letter-spacing:7px;color:var(--red-hi);margin-top:6px}
#splash .heat{width:200px;height:6px;border-radius:3px;background:#2A0D0D;overflow:hidden}
#splash .heat i{display:block;height:100%;width:100%;border-radius:3px;background:linear-gradient(90deg,#8E0B0B,#FF4538,#FFB347);transform-origin:left;transform:scaleX(.08)}
#splash .msg{font-family:'Oswald',sans-serif;font-weight:500;font-size:13px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;text-align:center;padding:0 24px}
#splash .sparks{position:absolute;left:0;right:0;bottom:0;height:60%;overflow:hidden;pointer-events:none}
#splash .sparks b{position:absolute;bottom:-10px;width:4px;height:4px;border-radius:50%;background:#FFB347;box-shadow:0 0 8px 2px rgba(255,120,40,.8);opacity:0}
@media (prefers-reduced-motion:no-preference){
  #splash .logo{animation:glow 1.3s ease-in-out infinite alternate}
  #splash .heat i{animation:heat 1.6s cubic-bezier(.3,.1,.2,1) forwards}
  #splash .sparks b{animation:rise 2.4s ease-out infinite}
  #splash .sparks b:nth-child(1){left:12%;animation-delay:.0s}
  #splash .sparks b:nth-child(2){left:27%;animation-delay:.7s;width:3px;height:3px}
  #splash .sparks b:nth-child(3){left:41%;animation-delay:1.3s}
  #splash .sparks b:nth-child(4){left:58%;animation-delay:.3s;width:3px;height:3px}
  #splash .sparks b:nth-child(5){left:73%;animation-delay:1.0s}
  #splash .sparks b:nth-child(6){left:88%;animation-delay:1.7s;width:3px;height:3px}
  @keyframes glow{from{box-shadow:0 0 0 1px #7A1414,0 0 26px 2px rgba(209,10,10,.4)}to{box-shadow:0 0 0 1px #B01818,0 0 56px 12px rgba(255,69,56,.7)}}
  @keyframes heat{to{transform:scaleX(1)}}
  @keyframes rise{0%{transform:translateY(0) translateX(0);opacity:0}15%{opacity:1}100%{transform:translateY(-52vh) translateX(18px);opacity:0}}
}
@media (prefers-reduced-motion:reduce){#splash .heat i{transform:scaleX(1)}}

@media (prefers-reduced-motion:no-preference){
  .chip,.btn,.lnk,.more{transition:background-color .15s,color .15s,border-color .15s}
}
</style>
