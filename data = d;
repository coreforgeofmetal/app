          el('small', null, 'bei ' + host(t))) : null));
  }

  /* ---------- Liste ---------- */
  function renderList(base) {
    var items = filtered(base);
    listHost.textContent = '';
    if (!items.length) {
      var hasFilter = state.q || Object.keys(state.f).some(function (k) { return state.f[k]; });
      listHost.appendChild(hasFilter
        ? el('div', { class: 'empty' }, el('strong', null, 'KEINE TREFFER'), el('span', null, 'Zu dieser Auswahl gibt es nichts. Ändere die Suche oder setze die Filter zurück.'),
            el('button', { class: 'more', type: 'button', onclick: function () { state.q = ''; state.f = {}; searchInput.value = ''; update(); } }, 'Filter zurücksetzen'))
        : el('div', { class: 'empty' }, el('strong', null, 'NOCH NICHTS DA'), el('span', null, 'Hier erscheinen neue Einträge, sobald der nächste Digest oder die nächste Aktualisierung durch ist.')));
      return;
    }
    var shown = items.slice(0, state.limit);
    var tab = state.tab, groups;
    if (tab === 'neu') {
      groups = groupBy(shown, function (r) { var d = parseDay(r.date); return d && dayDiff(d) > 0 ? 'Angekündigt' : 'Neu erschienen'; });
      groups.sort(function (a) { return a.key === 'Angekündigt' ? -1 : 1; });
    } else if (tab === 'konzerte') {
      groups = groupBy(shown, function (c) { var d = parseDay(c.date); return d ? monthHeading(d) : 'Ohne Datum'; });
    } else {
      groups = groupBy(shown, function (n) { var d = parseDay(n.date); return d ? dayHeading(d) : 'Ohne Datum'; });
    }
    groups.forEach(function (g) {
      listHost.appendChild(el('h2', { class: 'gh' }, g.key));
      g.items.forEach(function (it) {
        listHost.appendChild(tab === 'neu' ? releaseCard(it) : tab === 'konzerte' ? concertCard(it) : newsCard(it));
      });
    });
    if (items.length > shown.length) {
      listHost.appendChild(el('button', { class: 'more', type: 'button', onclick: function () { state.limit += PAGE; renderList(base); } },
        'Mehr anzeigen (' + (items.length - shown.length) + ' weitere)'));
    }
    if (tab === 'konzerte') listHost.appendChild(el('p', { class: 'note' }, 'Termine und Ticketlinks stammen von Ticketmaster und Veranstaltern. Angaben ohne Gewähr.'));
  }

  function update() {
    var base = baseItems();
    renderChips(base);
    renderList(base);
  }

  function renderView() {
    var t = TABS.filter(function (x) { return x.id === state.tab; })[0];
    document.title = t.title.charAt(0) + t.title.slice(1).toLowerCase() + ' – Core Forge of Metal';
    host$.textContent = '';
    searchInput = el('input', { type: 'search', id: 'q', placeholder: 'Band, Song oder Stadt suchen', autocomplete: 'off', enterkeyhint: 'search',
      oninput: function () { state.q = searchInput.value; state.limit = PAGE; renderList(baseItems()); } });
    chipsHost = el('div');
    listHost = el('div', { class: 'list' });
    host$.appendChild(el('div', { class: 'head' }, el('h1', null, t.title), el('p', null, typeof t.sub === 'function' ? t.sub() : t.sub)));
    if (state.tab === 'news') {
      var rc = reelCard();
      if (rc) host$.appendChild(rc);
      var qz = latestQuiz();
      if (qz) { streakNode = streakCard(); host$.appendChild(streakNode); host$.appendChild(quizCard(qz)); }
    }
    host$.appendChild(el('label', { class: 'search' }, svg('<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>', 20, ' style="color:#A8A8A8"'), el('span', { class: 'sr', style: 'position:absolute;left:-9999px' }, 'Suchen'), searchInput));
    host$.appendChild(chipsHost);
    host$.appendChild(listHost);
    update();
  }

  function go() {
    state.tab = tabFromHash();
    state.f = {}; state.q = ''; state.limit = PAGE;
    renderTabs();
    if (data) renderView();
    window.scrollTo(0, 0);
  }

  function showLoading() {
    host$.textContent = '';
    host$.appendChild(el('p', { class: 'note', role: 'status' }, 'Lade Daten …'));
  }
  function showError() {
    host$.textContent = '';
    host$.appendChild(el('div', { class: 'empty', role: 'alert' },
      el('strong', null, 'KEINE VERBINDUNG'),
      el('span', null, 'Die Daten konnten nicht geladen werden. Prüfe deine Internetverbindung und versuche es erneut.'),
      el('button', { class: 'again', type: 'button', onclick: start }, 'Erneut versuchen')));
  }

  var splashT0 = Date.now();
  function hideSplash() {
    var sp = document.getElementById('splash');
    if (!sp) return;
    var wait = Math.max(0, 1600 - (Date.now() - splashT0));
    setTimeout(function () {
      sp.classList.add('out');
      setTimeout(function () { if (sp.parentNode) sp.parentNode.removeChild(sp); }, 600);
    }, wait);
  }

  function start() {
    showLoading();
    load().then(function () { setStand(); renderView(); }).catch(showError).then(hideSplash);
  }

  window.addEventListener('hashchange', go);
  state.tab = tabFromHash();
  renderTabs();
  start();

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function () { navigator.serviceWorker.register('sw.js').catch(function () {}); });
  }
})();
</script>
</body>
</html>
