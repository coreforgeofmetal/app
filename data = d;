<script>
(function () {
  'use strict';

  /* ---------- Hilfsfunktionen ---------- */
  var DATA_URL = 'data/data.json';
  var PAGE = 40;

  function el(tag, props) {
    var n = document.createElement(tag);
    if (props) Object.keys(props).forEach(function (k) {
      var v = props[k];
      if (v === null || v === undefined || v === false) return;
      if (k === 'class') n.className = v;
      else if (k === 'text') n.textContent = v;
      else if (k.indexOf('on') === 0) n.addEventListener(k.slice(2), v);
      else n.setAttribute(k, v === true ? '' : v);
    });
    for (var i = 2; i < arguments.length; i++) append(n, arguments[i]);
    return n;
  }
  function append(n, c) {
    if (c === null || c === undefined || c === false) return;
    if (Array.isArray(c)) { c.forEach(function (x) { append(n, x); }); return; }
    n.appendChild(c.nodeType ? c : document.createTextNode(String(c)));
  }
  function svg(path, size, extra) {
    var t = document.createElement('template');
    t.innerHTML = '<svg width="' + (size || 24) + '" height="' + (size || 24) + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' + (extra || '') + '>' + path + '</svg>';
    return t.content.firstChild;
  }
  function safeUrl(u) { return (typeof u === 'string' && /^https?:\/\//i.test(u)) ? u : null; }
  function host(u) { try { return new URL(u).hostname.replace(/^www\./, ''); } catch (e) { return ''; } }
  function norm(s) { return String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
  function parseDay(s) {
    var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s || '');
    return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
  }
  var now = new Date();
  var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  function dayDiff(d) { return Math.round((d - today) / 86400000); }
  var MON = ['JAN', 'FEB', 'MÄR', 'APR', 'MAI', 'JUN', 'JUL', 'AUG', 'SEP', 'OKT', 'NOV', 'DEZ'];
  function dayHeading(d) {
    var diff = dayDiff(d);
    if (diff === 0) return 'Heute';
    if (diff === -1) return 'Gestern';
    var o = { weekday: 'long', day: 'numeric', month: 'long' };
    if (d.getFullYear() !== today.getFullYear()) o.year = 'numeric';
    return d.toLocaleDateString('de-DE', o);
  }
  function monthHeading(d) {
    return d.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
  }
  var regionNames = null;
  try { regionNames = new Intl.DisplayNames(['de'], { type: 'region' }); } catch (e) { /* ältere Browser */ }
  function country(code) {
    if (!code) return '';
    try { return regionNames ? regionNames.of(String(code).toUpperCase()) : code; } catch (e) { return code; }
  }
  function groupBy(items, keyFn) {
    var groups = [], idx = {};
    items.forEach(function (it) {
      var k = keyFn(it);
      if (!(k in idx)) { idx[k] = groups.length; groups.push({ key: k, items: [] }); }
      groups[idx[k]].items.push(it);
    });
    return groups;
  }

  /* ---------- Daten ---------- */
  var data = null, bandMap = {}, ticketByBand = {};
  function bandGenres(slug) { return (bandMap[slug] && bandMap[slug].genres) || []; }

  function load() {
    return fetch(DATA_URL, { cache: 'no-cache' }).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    }).then(function (d) {
      d = d || {};
      ['bands', 'news', 'concerts', 'releases', 'quiz', 'reels'].forEach(function (k) { if (!Array.isArray(d[k])) d[k] = []; });
            d.news = d.news.filter(function (n) { var x = parseDay(n && n.date); return !x || x <= today; });
      data = d;
            d.news = d.news.filter(function (n) { var x = parseDay(n && n.date); return !x || x <= today; });
      bandMap = {};
      d.bands.forEach(function (b) { if (b && b.slug) bandMap[b.slug] = b; });
      ticketByBand = {};
      d.concerts.forEach(function (c) {
        if (!c || !c.band_slug || !safeUrl(c.ticket_url)) return;
        var dt = parseDay(c.date);
        if (!dt || dt < today) return;
        var cur = ticketByBand[c.band_slug];
        var isDe = String(c.country).toUpperCase() === 'DE', curDe = cur && String(cur.country).toUpperCase() === 'DE';
        if (!cur || (isDe && !curDe) || (isDe === curDe && String(c.date) < String(cur.date))) ticketByBand[c.band_slug] = c;
      });
    });
  }

  /* Dynamische Zeile unter "Frisch geschmiedet" */
  function newsSub() {
    var fallback = 'Die Metal-News des Tages – heiß vom Amboss.';
    if (!data || !data.news.length) return fallback;
    var max = '';
    data.news.forEach(function (n) { if (n.date && String(n.date) > max) max = String(n.date); });
    var d = parseDay(max);
    if (!d) return fallback;
    var items = data.news.filter(function (n) { return String(n.date) === max; });
    var tips = items.filter(function (n) { return n.is_tip === true; }).length;
